# Runtime
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=1
FRONTEND_PUBLIC_URL=https://www.readyexpressnow.com
BACKEND_PUBLIC_URL=https://readyexpressnowbackend.versabold.com
CORS_ORIGINS=https://www.readyexpressnow.com,https://readyexpressnow.com

# Supabase — solo backend; nunca copiar la service role al frontend
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_publishable_o_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# TropiPay — todas estas variables viven únicamente en el backend
# Producción: https://tropipay.com o el host productivo indicado por TropiPay
# Sandbox: https://sandbox.tropipay.me
TROPIPAY_URL_BASE=https://sandbox.tropipay.me
TROPIPAY_CLIENT_ID=tu_client_id
# El mismo client id/secret sirve para pedir el token y para comprobar la firma del webhook (signaturev3)
TROPIPAY_CLIENT_SECRET=tu_client_secret
TROPIPAY_CURRENCY=USD
TROPIPAY_COUNTRY_ISO=CU
# Mantener en false hasta habilitar nuevamente pagos con tarjeta en frontend y backend.
CARD_PAYMENTS_ENABLED=false
# Si se omite, se construye desde BACKEND_PUBLIC_URL:
# TROPIPAY_NOTIFICATION_URL=https://readyexpressnowbackend.versabold.com/api/payments/tropipay/webhook

# Storage
DELIVERY_CONFIRMATIONS_BUCKET=delivery-confirmations

# Email / impresión / notificaciones existentes
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMPRESORA_EMAIL=
OWNER_EMAIL_1=
OWNER_EMAIL_2=
OWNER_EMAIL_3=
RESEND_API_KEY=
RESEND_FROM=
VERSABOLD_SMS_URL=
VERSABOLD_API_KEY=
SMS_NOTIFY_PHONES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Push para clientes que desean avisos de compras por referido.
# Generar una vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@readyexpressnow.com

# Solo pruebas locales: silencia avisos (sms, email, print o all). No definir en producción.
# MUTE_NOTIFICATIONS=sms,email,print
